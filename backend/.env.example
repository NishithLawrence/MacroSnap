# MacroSnap Backend Environment Configuration Example
# Copy this file to backend/.env and configure your values.
# DO NOT commit real secrets, passwords, or API keys to version control.

# Application Environment Mode: production | development | test (Default: production)
APP_ENV=production

# Reviewer Demo Authentication (Required in production)
# Must be at least 8 characters. Used by portfolio reviewers to access the shared sandbox.
DEMO_PASSWORD=your_demo_reviewer_passcode_here

# Server-only JWT Signing Secret (Required in production)
# Must be at least 32 characters. Used to sign short-lived Bearer tokens (PyJWT, HS256).
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET_KEY=your_strong_32_character_signing_secret_here

# Token Expiry in hours: Integer between 1 and 72 (Optional, default: 4 hours)
TOKEN_EXPIRE_HOURS=4

# Development-only Unauthenticated Bypass
# Set to 'true' ONLY when APP_ENV=development for offline testing without reviewer login.
# Ignored and strictly rejected if APP_ENV is production or test.
# ALLOW_UNAUTHENTICATED=false

# Trusted Proxy Configuration for Rate Limiting
# When false (default), rate limiting strictly uses direct peer address (request.client.host).
# Set to 'true' ONLY when running behind a trusted reverse proxy (e.g. Render/Cloudflare)
# and direct peer is a verified private network IP.
# TRUST_PROXY_HEADERS=false

# Google Gemini API Key for Vision meal scans and Nutrition Coach assistant
GEMINI_API_KEY=

# Production Frontend URL for explicit CORS configuration (e.g. on Render)
# FRONTEND_ORIGIN=https://macro-snap-eosin.vercel.app

# Optional Custom Vercel Preview Regex for CORS (defaults to user project pattern)
# FRONTEND_PREVIEW_REGEX=^https:\/\/macro-snap-[a-z0-9-]+-nishithlawrence.*\.vercel\.app$
